@@ -0,0 +1,17 @@
+/** Client for stockroom-inventory: hold stock before charging, give it back if payment fails. */
+export class StockroomClient {
+  constructor(private baseUrl: string) {}
+
+  async reserve(orderId: string, items: { sku: string; quantity: number }[]): Promise<boolean> {
+    const res = await fetch(`${this.baseUrl}/v1/reservations`, {
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({ orderId, items }),
+    });
+    return res.status === 201;
+  }
+
+  async release(orderId: string): Promise<void> {
+    await fetch(`${this.baseUrl}/v1/reservations/${orderId}`, { method: "DELETE" });
+  }
+}
