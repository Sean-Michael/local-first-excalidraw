diff --git a/services/ledger-orders/src/routes/paylodeWebhook.ts b/services/ledger-orders/src/routes/paylodeWebhook.ts
new file mode 100644
--- /dev/null
+++ b/services/ledger-orders/src/routes/paylodeWebhook.ts
@@ -0,0 +1,23 @@
+import crypto from "node:crypto";
+import type { FastifyInstance } from "fastify";
+import type { OrderEventsPublisher } from "../events/orderEventsPublisher.js";
+import type { OrderRepository } from "../repo/orderRepository.js";
+
+/**
+ * POST /v1/webhooks/paylode: Paylode calls this when a charge settles or is disputed.
+ * The body is signed with the shared webhook secret (header `paylode-signature`).
+ */
+export function registerPaylodeWebhook(app: FastifyInstance, deps: { orders: OrderRepository; events: OrderEventsPublisher; secret: string }) {
+  app.post("/v1/webhooks/paylode", { config: { rawBody: true } }, async (req, reply) => {
+    const raw = (req as any).rawBody as string;
+    const expected = crypto.createHmac("sha256", deps.secret).update(raw).digest("hex");
+    if (req.headers["paylode-signature"] !== expected) return reply.code(400).send({ error: "bad signature" });
+
+    const event = JSON.parse(raw) as { type: string; data: { charge_id: string; order_ref: string } };
+    if (event.type === "charge.disputed") {
+      await deps.orders.markDisputed(event.data.order_ref);
+      await deps.events.orderDisputed({ orderId: event.data.order_ref, chargeId: event.data.charge_id });
+    }
+    return { received: true };
+  });
+}
