@@ -0,0 +1,33 @@
+import type { Pool } from "@shopapp/db";
+
+/** stock_levels and stock_reservations tables. */
+export class ReservationRepository {
+  constructor(private pool: Pool) {}
+
+  async reserve(orderId: string, items: { sku: string; quantity: number }[]): Promise<boolean> {
+    const client = await this.pool.connect();
+    try {
+      await client.query("begin");
+      for (const i of items) {
+        const r = await client.query("update stock_levels set available = available - $2 where sku = $1 and available >= $2", [i.sku, i.quantity]);
+        if (r.rowCount === 0) {
+          await client.query("rollback");
+          return false;
+        }
+        await client.query("insert into stock_reservations (order_id, sku, quantity) values ($1, $2, $3)", [orderId, i.sku, i.quantity]);
+      }
+      await client.query("commit");
+      return true;
+    } finally {
+      client.release();
+    }
+  }
+
+  async release(orderId: string) {
+    await this.pool.query(
+      "update stock_levels s set available = available + r.quantity from stock_reservations r where r.order_id = $1 and r.sku = s.sku",
+      [orderId],
+    );
+    await this.pool.query("delete from stock_reservations where order_id = $1", [orderId]);
+  }
+}
diff --git a/services/stockroom-inventory/src/server.ts b/services/stockroom-inventory/src/server.ts
new file mode 100644
--- /dev/null
+++ b/services/stockroom-inventory/src/server.ts
@@ -0,0 +1,20 @@
+import Fastify from "fastify";
+import { createPool } from "@shopapp/db";
+import { ReservationRepository } from "./reservationRepository.js";
+
+const app = Fastify({ logger: true });
+const reservations = new ReservationRepository(createPool(process.env.DATABASE_URL!));
+
+/** Holds stock for an order. Fails with 409 if any SKU is short. */
+app.post("/v1/reservations", async (req, reply) => {
+  const { orderId, items } = req.body as { orderId: string; items: { sku: string; quantity: number }[] };
+  const ok = await reservations.reserve(orderId, items);
+  return ok ? reply.code(201).send({ orderId }) : reply.code(409).send({ error: "out of stock" });
+});
+
+app.delete("/v1/reservations/:orderId", async (req) => {
+  await reservations.release((req.params as { orderId: string }).orderId);
+  return { ok: true };
+});
+
+app.listen({ port: 7003, host: "0.0.0.0" });
