diff --git a/services/keymaster-auth/src/cache/memoryTokenCache.ts b/services/keymaster-auth/src/cache/memoryTokenCache.ts
new file mode 100644
--- /dev/null
+++ b/services/keymaster-auth/src/cache/memoryTokenCache.ts
@@ -0,0 +1,29 @@
+import type { TokenCache } from "./tokenCache.js";
+
+/**
+ * Session tokens in process memory. keymaster-auth runs as a single replica, so the Redis
+ * token-cache was not buying anything; sessions now end when the process restarts.
+ */
+export class MemoryTokenCache implements TokenCache {
+  private tokens = new Map<string, { userId: string; expiresAt: number }>();
+
+  constructor(private ttlSeconds: number) {}
+
+  async put(token: string, userId: string) {
+    this.tokens.set(token, { userId, expiresAt: Date.now() + this.ttlSeconds * 1000 });
+  }
+
+  async get(token: string) {
+    const t = this.tokens.get(token);
+    if (!t) return null;
+    if (t.expiresAt < Date.now()) {
+      this.tokens.delete(token);
+      return null;
+    }
+    return t.userId;
+  }
+
+  async revoke(token: string) {
+    this.tokens.delete(token);
+  }
+}
